# Every variable here is required, unless marked optional: the server won't start until they're
# all set.

# Powers the agent. Sign in to the Claude Console, open API Keys, and create a key:
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Atomic's sandbox by default. Use sandbox API keys from the Atomic console.
# For production, set ATOMIC_API_BASE_URL=https://api.atomicfi.com with production keys.
ATOMIC_API_BASE_URL=https://sandbox-api.atomicfi.com
ATOMIC_API_KEY=
ATOMIC_API_SECRET=

# The user every chat acts as, and the identifier Atomic knows them by. Any string works.
USER_IDENTIFIER=

# Opens an ngrok tunnel when the server starts, so Atomic's webhooks can reach it. The server then
# points Atomic's webhook endpoint at the tunnel. Get a token from the ngrok dashboard:
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Optional, for paid ngrok plans: a domain you've reserved in the ngrok dashboard, such as
# deposits.ngrok.app. The tunnel then keeps the same URL every time the server starts.
# Leave it empty for a new URL on each start.
NGROK_DOMAIN=

# Optional: mirror the Fractional Deposits settings on your account in the Atomic Console, which the
# API doesn't return. FRACTIONAL_DEPOSITS=false allows only whole-paycheck switches (default: true).
# DEPOSIT_AMOUNT_CAN_UPDATE=true lets the user change, in the Atomic screen, the amount the agent
# confirmed (default: false).
FRACTIONAL_DEPOSITS=
DEPOSIT_AMOUNT_CAN_UPDATE=

# Optional: where the agent's tool definitions come from, a path or URL to a tools.json. Defaults to
# the published file, https://docs.atomicfi.com/agent-tools/deposit/tools.json. Point it at a local
# copy to try changed definitions before they're published.
TOOL_DEFINITIONS=
